// NOVA Database Schema
// Calorie Deficit Coach

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Domain
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String?   // null if using OAuth
  provider      String    @default("local") // "local", "google", "apple"
  providerId    String?   @map("provider_id") // ID from OAuth provider
  emailVerified Boolean   @default(false) @map("email_verified")
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")
  refreshToken  String?   @map("refresh_token")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profile        Profile?
  dailyEntries   DailyEntry[]
  calorieEntries CalorieEntry[]
  weightLogs     WeightLog[]
  chatMessages   ChatMessage[]

  // Indexes
  @@index([provider, providerId])
  @@map("users")
}

// ============================================
// Profile Domain
// ============================================

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  weight        Float
  height        Float
  age           Int
  sex           String   // male, female, other
  objective     String   // weight_loss, muscle_gain, maintenance, energy, sleep, stress
  activityLevel String   @default("moderate") @map("activity_level") // sedentary, light, moderate, active, very_active
  goalWeight    Float?   @map("goal_weight") // target weight in kg
  weeklyGoal    Float?   @default(0.5) @map("weekly_goal") // kg/week to lose
  targetWeeks   Int?     @map("target_weeks") // weeks to reach goal weight
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================
// Daily Entry Domain (legacy, kept for compatibility)
// ============================================

model DailyEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       DateTime
  type       String   // food, exercise, sleep, mood, energy, custom
  data       Json     @default("{}")
  novaPoints Int      @default(0) @map("nova_points")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@index([userId, type])
  @@map("daily_entries")
}

// ============================================
// Calorie Entry Domain
// ============================================

model CalorieEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime
  type        String   // intake, burn
  description String
  calories    Int
  items       Json     @default("[]") // JSON array: [{name, calories}]
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@index([userId, confirmed])
  @@map("calorie_entries")
}

// ============================================
// Weight Log Domain
// ============================================

model WeightLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  weight    Float    // kg
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@map("weight_logs")
}

// ============================================
// Chat Message Domain
// ============================================

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // text, image, weight, sleep, meal, workout, energy
  content   String
  imageUrl  String?  @map("image_url")
  sender    String   // user, agent
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, createdAt])
  @@map("chat_messages")
}
