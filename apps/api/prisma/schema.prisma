// NOVA Database Schema
// Calorie Deficit Coach
// SQLite version for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User Domain
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile        Profile?
  dailyEntries   DailyEntry[]
  calorieEntries CalorieEntry[]
  weightLogs     WeightLog[]

  @@map("users")
}

// ============================================
// Profile Domain
// ============================================

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  weight        Float
  height        Float
  age           Int
  sex           String   // male, female, other
  objective     String   // weight_loss, muscle_gain, maintenance, energy, sleep, stress
  activityLevel String   @default("moderate") @map("activity_level") // sedentary, light, moderate, active, very_active
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================
// Daily Entry Domain (legacy, kept for compatibility)
// ============================================

model DailyEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       DateTime
  type       String   // food, exercise, sleep, mood, energy, custom
  data       String   @default("{}")
  novaPoints Int      @default(0) @map("nova_points")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@index([userId, type])
  @@map("daily_entries")
}

// ============================================
// Calorie Entry Domain
// ============================================

model CalorieEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime
  type        String   // intake, burn
  description String
  calories    Int
  items       String   @default("[]") // JSON array: [{name, calories}]
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@index([userId, confirmed])
  @@map("calorie_entries")
}

// ============================================
// Weight Log Domain
// ============================================

model WeightLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  weight    Float    // kg
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, date])
  @@map("weight_logs")
}
