# Database
DATABASE_URL="postgresql://nova:nova_password@localhost:5432/nova_db?schema=public"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Claude API (Anthropic)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Redis (for BullMQ queue)
# Optional - if not set, messages are processed synchronously
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth - Apple (optional)
# Requires Apple Developer account
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CALLBACK_URL=http://localhost:3001/api/auth/apple/callback

# Email (SMTP) - for password reset
# Example using Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@nova.app

# Frontend URL (for email links and OAuth redirects)
FRONTEND_URL=http://localhost:3000
