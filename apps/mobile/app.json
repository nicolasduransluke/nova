{
  "expo": {
    "name": "NOVA",
    "slug": "nova-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nova",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cotalker.nova-mobile",
      "buildNumber": "19",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NOVA necesita acceso a tu cámara para tomar fotos de tus comidas.",
        "NSPhotoLibraryUsageDescription": "NOVA necesita acceso a tus fotos para seleccionar imágenes de tus comidas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "NOVA necesita acceso a tus fotos para seleccionar imágenes de tus comidas.",
          "cameraPermission": "NOVA necesita acceso a tu cámara para tomar fotos de tus comidas."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "662ca1ff-c27e-410a-93f6-29f0eb944ac2"
      }
    },
    "owner": "nicolasdurans",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/662ca1ff-c27e-410a-93f6-29f0eb944ac2"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
