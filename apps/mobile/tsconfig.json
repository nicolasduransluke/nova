{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nova/types": ["../../packages/types/src"],
      "@nova/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/types/src/**/*.ts", "../../packages/utils/src/**/*.ts"]
}
